{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.noeos.dev/verifactu/governance/historical-disposition.schema.json",
  "title": "Historical finding disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding", "state", "owner", "current-links", "rationale"],
  "properties": {
    "finding": {"type": "string", "pattern": "^REV-(?:00[1-9]|0[1-7][0-9]|08[0-4])$"},
    "state": {"enum": ["adopted", "superseded", "not-applicable-demonstrated", "blocked", "verified-prevented"]},
    "owner": {"type": "string", "minLength": 1},
    "current-links": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"}
    },
    "rationale": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVD-[0-9]{4,}$"}
    }
  }
}
