      "requireConversationResolution": true,
      "requireExtraApprovalForUnattributedChanges": true,
      "requireLastPushApproval": false,
      "requireLinearHistory": true,
      "requirePullRequest": true,
      "requireSignedCommits": true,
      "requiredApprovingReviewCount": 1,
      "requiredChecks": [
        "Required · quality and policy",
        "Required · regulatory sources and traceability",
        "Required · RRSIF conformance",
        "Required · ubuntu-24.04 · Node 22.14.0",
        "Required · ubuntu-24.04 · Node 22.23.2",
        "Required · ubuntu-24.04 · Node 24.20.0",
        "Required · windows-2025 · Node 24.20.0",
        "Required · macos-15 · Node 24.20.0",
        "Required · package reproducibility",
        "Required · dependency review",
        "Required · CodeQL",
        "Required · secret scan",
        "Required · OSV",
        "Required · npm audit and license inventory",
        "Required · phase 9 performance budgets",
        "Required · application security boundaries"
      ],
      "strictRequiredChecks": true
    }
  },
  "tags": {
