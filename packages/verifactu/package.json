{
  "name": "@noeos/verifactu",
  "version": "0.0.0-development",
  "private": true,
  "description": "Noeos VERI*FACTU library foundation.",
  "license": "Apache-2.0",
  "author": "Noeos contributors",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0 <25"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./editions": {
      "types": "./dist/types/editions.d.ts",
      "import": "./dist/esm/editions.js",
      "require": "./dist/cjs/editions.js"
    },
    "./schemas": {
      "types": "./dist/types/schemas.d.ts",
      "import": "./dist/esm/schemas.js",
      "require": "./dist/cjs/schemas.js"
    },
    "./catalogs": {
      "types": "./dist/types/catalogs.d.ts",
      "import": "./dist/esm/catalogs.js",
      "require": "./dist/cjs/catalogs.js"
    },
    "./xml": {
      "types": "./dist/types/xml/index.d.ts",
      "import": "./dist/esm/xml/index.js",
      "require": "./dist/cjs/xml/index.js"
    },
    "./qr": {
      "types": "./dist/types/qr/public.d.ts",
      "import": "./dist/esm/qr/public.js",
      "require": "./dist/cjs/qr/public.js"
    },
    "./signatures": {
      "types": "./dist/types/signatures/public.d.ts",
      "import": "./dist/esm/signatures/public.js",
      "require": "./dist/cjs/signatures/public.js"
    },
    "./certificates": {
      "types": "./dist/types/certificates/public.d.ts",
      "import": "./dist/esm/certificates/public.js",
      "require": "./dist/cjs/certificates/public.js"
    },
    "./ports": {
      "types": "./dist/types/ports/index.d.ts",
      "import": "./dist/esm/ports/index.js",
      "require": "./dist/cjs/ports/index.js"
    },
    "./state": {
      "types": "./dist/types/state/index.d.ts",
      "import": "./dist/esm/state/index.js",
      "require": "./dist/cjs/state/index.js"
    },
    "./submissions": {
      "types": "./dist/types/submissions/index.d.ts",
      "import": "./dist/esm/submissions/index.js",
      "require": "./dist/cjs/submissions/index.js"
    },
    "./transport": {
      "types": "./dist/types/transport/index.d.ts",
      "import": "./dist/esm/transport/index.js",
      "require": "./dist/cjs/transport/index.js"
    },
    "./application": {
      "types": "./dist/types/application/index.d.ts",
      "import": "./dist/esm/application/index.js",
      "require": "./dist/cjs/application/index.js"
    },
    "./outbox": {
      "types": "./dist/types/outbox/index.d.ts",
      "import": "./dist/esm/outbox/index.js",
      "require": "./dist/cjs/outbox/index.js"
    }
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "dependencies": {
    "@noeos/verification-engine": "1.0.1",
    "@xmldom/xmldom": "0.9.12",
    "qrcode": "1.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeos/verifactu.git",
    "directory": "packages/verifactu"
  },
  "bugs": {
    "url": "https://github.com/noeos/verifactu/issues"
  },
  "homepage": "https://github.com/noeos/verifactu/tree/main/docs",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
