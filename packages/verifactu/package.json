{
  "name": "@noeos/verifactu",
  "version": "0.0.0-development",
  "private": true,
  "description": "Noeos VERI*FACTU library foundation.",
  "license": "Apache-2.0",
  "author": "Noeos contributors",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0 <25"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./editions": {
      "types": "./dist/types/editions.d.ts",
      "import": "./dist/esm/editions.js",
      "require": "./dist/cjs/editions.js"
    },
    "./schemas": {
      "types": "./dist/types/schemas.d.ts",
      "import": "./dist/esm/schemas.js",
      "require": "./dist/cjs/schemas.js"
    },
    "./catalogs": {
      "types": "./dist/types/catalogs.d.ts",
      "import": "./dist/esm/catalogs.js",
      "require": "./dist/cjs/catalogs.js"
    }
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "dependencies": {
    "@noeos/verification-engine": "1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeos/verifactu.git",
    "directory": "packages/verifactu"
  },
  "bugs": {
    "url": "https://github.com/noeos/verifactu/issues"
  },
  "homepage": "https://github.com/noeos/verifactu/tree/main/docs",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
