{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtures"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "control", "expectedCode"],
        "properties": {
          "id": { "type": "string" },
          "control": { "type": "string" },
          "expectedCode": { "type": "string" }
        }
      }
    }
  }
}
