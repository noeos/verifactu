{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noeos.dev/schemas/package-content-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "packages"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "policyId": { "const": "PACKAGE-CONTENT-0001" },
    "packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directory", "name", "entry", "formats", "tarball", "allowedFiles"],
        "properties": {
          "directory": { "type": "string" },
          "name": { "type": "string" },
          "entry": { "type": "string", "pattern": "^src/.*\\.ts$" },
          "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["esm", "cjs"] } },
          "tarball": { "type": "string", "pattern": "\\.tgz$" },
          "allowedFiles": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
