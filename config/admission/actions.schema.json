{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noeos.dev/schemas/action-admission-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "actions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "policyId": { "const": "ACTION-ADMISSION-0001" },
    "actions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "sha", "release", "license", "permissions", "purpose"],
        "properties": {
          "repository": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$" },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "release": { "type": "string" },
          "license": { "enum": ["MIT", "Apache-2.0"] },
          "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "purpose": { "type": "string", "minLength": 12 }
        }
      }
    }
  }
}
