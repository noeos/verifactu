{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noeos.dev/schemas/p3-regulatory-traceability-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matrixId", "sourceSnapshotId", "candidateEditionId", "requirements"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "matrixId": { "const": "P3-TRACEABILITY-0001" },
    "sourceSnapshotId": { "type": "string", "minLength": 1 },
    "candidateEditionId": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "sourceIds",
          "contractPaths",
          "oracleControls",
          "blockerIds",
          "nextPhase",
          "rationale"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(REG|SEC|PRIV)-[0-9]{4}$" },
          "status": {
            "enum": ["enforced", "preventive", "blocked", "downstream"]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$" }
          },
          "contractPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(edition\\.json|contracts/[A-Za-z0-9][A-Za-z0-9._-]*\\.json|schemas/[A-Za-z0-9][A-Za-z0-9._-]*\\.json)$"
            }
          },
          "oracleControls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
            }
          },
          "blockerIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "nextPhase": { "type": ["string", "null"], "pattern": "^P[4-8]$" },
          "rationale": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
