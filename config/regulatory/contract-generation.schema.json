{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noeos.dev/schemas/regulatory-contract-generation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatorId",
    "sourceSnapshotId",
    "candidateEditionId",
    "limits",
    "doctypeNeutralization",
    "importAliases",
    "supportedElements"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "generatorId": { "const": "RRSIF-CONTRACT-GENERATOR-0001" },
    "sourceSnapshotId": { "type": "string", "pattern": "^rrsif-[0-9]{4}-[0-9]{2}-[0-9]{2}\\+src\\.[0-9a-f]{12}$" },
    "candidateEditionId": {
      "type": "string",
      "pattern": "^rrsif-[0-9]{4}-[0-9]{2}-[0-9]{2}-candidate\\.[0-9a-f]{12}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumBytes", "maximumDepth", "maximumNodes", "maximumAttributesPerElement", "maximumTextBytes"],
      "properties": {
        "maximumBytes": { "type": "integer", "minimum": 1024, "maximum": 16000000 },
        "maximumDepth": { "type": "integer", "minimum": 8, "maximum": 256 },
        "maximumNodes": { "type": "integer", "minimum": 100, "maximum": 1000000 },
        "maximumAttributesPerElement": { "type": "integer", "minimum": 8, "maximum": 1024 },
        "maximumTextBytes": { "type": "integer", "minimum": 1024, "maximum": 16000000 }
      }
    },
    "doctypeNeutralization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sha256"],
      "properties": {
        "sourceId": { "const": "W3C-XMLDSIG-XSD" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "importAliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "namespace", "sourceId"],
        "properties": {
          "location": { "type": "string", "pattern": "^https?://" },
          "namespace": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" }
        }
      }
    },
    "supportedElements": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" }
      }
    }
  }
}
